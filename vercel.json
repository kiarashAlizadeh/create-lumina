{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "lumina.config.js",
          "routes.js",
          "app.js",
          "index.html",
          "api/**",
          "assets/**",
          "components/**"
        ]
      }
    }
  ],
  "routes": [{ "src": "/(.*)", "dest": "/server.js" }]
}
